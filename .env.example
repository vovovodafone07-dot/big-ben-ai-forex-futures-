# Big Ben AI Pro — safe production baseline
# Never commit real values. Keep broker execution disabled.

# Render / server
PORT=10000
DATABASE_URL=
BIGBEN_DB_PATH=/tmp/bigben-dev.sqlite3
BIGBEN_DASHBOARD_PASSWORD=
BIGBEN_WEBHOOK_TOKEN=

# TradingView / analysis pipeline
BIGBEN_SIGNAL_ANALYSIS_ENABLED=1
BIGBEN_AGENT_WATCHDOG_ENABLED=1
BIGBEN_ANALYSIS_KILL_SWITCH=0
BIGBEN_SYMBOL_QUEUE_SIZE=100
BIGBEN_DAILY_TELEGRAM_ENABLED=1
BIGBEN_MARKET_PULSE_SECONDS=300

# AI review (optional; does not execute trades)
BIGBEN_AI_ENABLED=0
BIGBEN_AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp remains disabled unless separately authorized and verified
BIGBEN_WHATSAPP_ENABLED=0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Historical provider only; not proof of a continuous live feed
TWELVE_DATA_API_KEY=
TWELVEDATA_API_KEY=

# Optional licensed research provider; do not guess futures mappings
BARCHART_API_KEY=
BIGBEN_BARCHART_SYMBOL_MAP=
BIGBEN_RESEARCH_REPORT=research/reports/latest.json

# Explicit safety boundary: this codebase has no broker-order endpoint.
# Do not add broker credentials or change broker_execution without a separate
# audited authorization and risk-control implementation.
