//@version=6
indicator("Big Ben AI | BBB-style Smart Money", overlay=true, max_boxes_count=150, max_lines_count=150, max_labels_count=150)
// Full indicator, not a strategy or broker executor. ICT/SMC/CRT/SMT are explicit heuristic rules.
// Signal sequence: sweep/CRT -> displacement + BOS/FVG -> retest -> confirmed entry.
// Use closed bars. Historical results are not a guarantee of future performance.
groupA = "01 | Core"
rr = input.float(2.0, "Final target RR", minval=0.5, maxval=8, step=0.25, group=groupA)
direction = input.string("Both", "Allowed direction", options=["Both","Buy","Sell"], group=groupA)
pivotLen = input.int(4, "Confirmed structure pivot", minval=2, maxval=20, group=groupA)
liqLen = input.int(15, "Liquidity lookback", minval=5, maxval=80, group=groupA)
setupExpiry = input.int(12, "Retest window (M5 bars)", minval=2, maxval=60, group=groupA)
cooldown = input.int(8, "Bars between trades", minval=0, maxval=100, group=groupA)
groupF = "02 | Filters"
useHTF = input.bool(true, "Require H1 + H4 trend agreement", group=groupF)
useCRT = input.bool(true, "Require CRT range reclaim at sweep", group=groupF)
requireFVG = input.bool(true, "Require FVG on displacement", group=groupF)
minBodyATR = input.float(0.55, "Displacement body / ATR", minval=0.1, maxval=3, step=0.05, group=groupF)
minRiskATR = input.float(0.5, "Min stop distance / ATR", minval=0.1, maxval=5, step=0.1, group=groupF)
maxRiskATR = input.float(3.0, "Max stop distance / ATR", minval=0.5, maxval=10, step=0.25, group=groupF)
useSMT = input.bool(false, "Require SMT divergence (off by default)", group=groupF)
smtSymbol = input.symbol("CME_MINI:ES1!", "Correlated comparison symbol", group=groupF)
groupV = "03 | BBB-style display"
showZones = input.bool(true, "Draw CRT / FVG setup boxes", group=groupV)
showTradeBoxes = input.bool(true, "Draw risk/reward boxes", group=groupV)
extendBars = input.int(24, "Extend trade boxes (bars)", minval=5, maxval=100, group=groupV)
showPanel = input.bool(true, "Show status panel", group=groupV)
groupN = "04 | Delivery"
delivery = input.string("App trades", "Alert delivery", options=["App trades","Webhook heartbeat","Off"], group=groupN)
webhookToken = input.string("", "Webhook token (keep private)", group=groupN)
// Higher-timeframe bias from previously CLOSED candles (no lookahead).
f_bias() =>
    ema20 = ta.ema(close, 20)
    ema50 = ta.ema(close, 50)
    close > ema50 and ema20 > ema50 ? 1 : close < ema50 and ema20 < ema50 ? -1 : 0
h1 = request.security(syminfo.tickerid, "60", f_bias()[1], lookahead=barmerge.lookahead_on)
h4 = request.security(syminfo.tickerid, "240", f_bias()[1], lookahead=barmerge.lookahead_on)
crtHigh = request.security(syminfo.tickerid, "60", high[1], lookahead=barmerge.lookahead_on)
crtLow = request.security(syminfo.tickerid, "60", low[1], lookahead=barmerge.lookahead_on)
atr = ta.atr(14)
isM5 = timeframe.period == "5"
ready = barstate.isconfirmed and isM5 and not na(atr)
trendBuy = not useHTF or (h1 == 1 and h4 == 1)
trendSell = not useHTF or (h1 == -1 and h4 == -1)
// Confirmed structure pivots are only known after pivotLen bars.
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float structureHigh = na
var float structureLow = na
if not na(ph)
    structureHigh := ph
if not na(pl)
    structureLow := pl
// Liquidity sweeps and previous completed H1 candle CRT reclaim.
sweepBuy = low < ta.lowest(low[1], liqLen) and close > ta.lowest(low[1], liqLen)
sweepSell = high > ta.highest(high[1], liqLen) and close < ta.highest(high[1], liqLen)
crtBuy = low < crtLow and close > crtLow
crtSell = high > crtHigh and close < crtHigh
// SMT: current instrument makes new extreme while comparison does not.
otherLow = request.security(smtSymbol, timeframe.period, low, ignore_invalid_symbol=true)
otherHigh = request.security(smtSymbol, timeframe.period, high, ignore_invalid_symbol=true)
smtBuy = not na(otherLow) and low < ta.lowest(low[1], liqLen) and otherLow >= ta.lowest(otherLow[1], liqLen)
smtSell = not na(otherHigh) and high > ta.highest(high[1], liqLen) and otherHigh <= ta.highest(otherHigh[1], liqLen)
// Three-candle FVG and displacement on closed candle.
bullFVG = low > high[2]
bearFVG = high < low[2]
bullImpulse = close > open and (close - open) >= atr * minBodyATR
bearImpulse = close < open and (open - close) >= atr * minBodyATR
bosBuy = not na(structureHigh) and close > structureHigh
bosSell = not na(structureLow) and close < structureLow
// Phase 1: arm on liquidity sweep (with optional CRT and SMT).
var int armedDir = 0
var int armedBar = na
var float sweepExtreme = na
var int pendingDir = 0
var int pendingBar = na
var float zoneTop = na
var float zoneBottom = na
var float invalidation = na
var box setupBox = na
if ready
    if armedDir != 0 and bar_index - armedBar > setupExpiry
        armedDir := 0
    if pendingDir != 0 and bar_index - pendingBar > setupExpiry
        pendingDir := 0
        if not na(setupBox)
            box.set_bgcolor(setupBox, color.new(color.gray, 92))
    if direction != "Sell" and trendBuy and (sweepBuy or crtBuy) and (not useCRT or crtBuy) and (not useSMT or smtBuy)
        armedDir := 1
        armedBar := bar_index
        sweepExtreme := low
        pendingDir := 0
    else if direction != "Buy" and trendSell and (sweepSell or crtSell) and (not useCRT or crtSell) and (not useSMT or smtSell)
        armedDir := -1
        armedBar := bar_index
        sweepExtreme := high
        pendingDir := 0
    // Phase 2: displacement with BOS and optional FVG after sweep.
    if armedDir == 1 and bar_index > armedBar and bullImpulse and bosBuy and (not requireFVG or bullFVG)
        pendingDir := 1
        pendingBar := bar_index
        zoneTop := requireFVG ? low : math.max(open, close - atr * 0.25)
        zoneBottom := requireFVG ? high[2] : open
        invalidation := sweepExtreme - atr * 0.2
        armedDir := 0
        if showZones
            setupBox := box.new(bar_index - 2, zoneTop, bar_index + setupExpiry, zoneBottom, bgcolor=color.new(color.teal, 85), border_color=color.teal)
    else if armedDir == -1 and bar_index > armedBar and bearImpulse and bosSell and (not requireFVG or bearFVG)
        pendingDir := -1
        pendingBar := bar_index
        zoneTop := requireFVG ? low[2] : open
        zoneBottom := requireFVG ? high : math.min(open, close + atr * 0.25)
        invalidation := sweepExtreme + atr * 0.2
        armedDir := 0
        if showZones
            setupBox := box.new(bar_index - 2, zoneTop, bar_index + setupExpiry, zoneBottom, bgcolor=color.new(color.red, 85), border_color=color.red)
// Phase 3: retest FVG/zone and close back through its midpoint.
var int lastTradeBar = na
coolOK = na(lastTradeBar) or bar_index - lastTradeBar > cooldown
mid = (zoneTop + zoneBottom) / 2
buyRetest = pendingDir == 1 and bar_index > pendingBar and low <= zoneTop and close > mid and close > open and close > invalidation
sellRetest = pendingDir == -1 and bar_index > pendingBar and high >= zoneBottom and close < mid and close < open and close < invalidation
riskBuy = close - invalidation
riskSell = invalidation - close
buy = ready and coolOK and buyRetest and trendBuy and riskBuy >= atr * minRiskATR and riskBuy <= atr * maxRiskATR
sell = ready and coolOK and sellRetest and trendSell and riskSell >= atr * minRiskATR and riskSell <= atr * maxRiskATR
if ready and pendingDir == 1 and low < invalidation
    pendingDir := 0
if ready and pendingDir == -1 and high > invalidation
    pendingDir := 0
if buy or sell
    pendingDir := 0
    lastTradeBar := bar_index
plotshape(buy, title="BBB BUY", text="BUY", style=shape.labelup, location=location.belowbar, color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
plotshape(sell, title="BBB SELL", text="SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
// Risk/reward zones: red SL box, green target box, entry and 3 targets.
var box lossBox = na
var box profitBox = na
var line entryLine = na
var line slLine = na
var line tp1Line = na
var line tp2Line = na
var line tp3Line = na
if (buy or sell) and showTradeBoxes
    if not na(lossBox)
        box.delete(lossBox)
        box.delete(profitBox)
        line.delete(entryLine)
        line.delete(slLine)
        line.delete(tp1Line)
        line.delete(tp2Line)
        line.delete(tp3Line)
    e = close
    sl = invalidation
    r = math.abs(e - sl)
    d = buy ? 1.0 : -1.0
    t1 = e + d * r * rr / 3
    t2 = e + d * r * rr * 2 / 3
    t3 = e + d * r * rr
    lossBox := box.new(bar_index, math.max(e, sl), bar_index + extendBars, math.min(e, sl), bgcolor=color.new(color.red, 86), border_color=color.new(color.red, 50))
    profitBox := box.new(bar_index, math.max(e, t3), bar_index + extendBars, math.min(e, t3), bgcolor=color.new(color.green, 88), border_color=color.new(color.green, 50))
    entryLine := line.new(bar_index, e, bar_index + extendBars, e, color=color.yellow)
    slLine := line.new(bar_index, sl, bar_index + extendBars, sl, color=color.red)
    tp1Line := line.new(bar_index, t1, bar_index + extendBars, t1, color=color.aqua)
    tp2Line := line.new(bar_index, t2, bar_index + extendBars, t2, color=color.aqua)
    tp3Line := line.new(bar_index, t3, bar_index + extendBars, t3, color=color.aqua)
    label.new(bar_index + extendBars, e, "ENTRY " + str.tostring(e, format.mintick), style=label.style_label_left, textcolor=color.yellow, color=color.new(color.black, 80), size=size.tiny)
    label.new(bar_index + extendBars, sl, "SL " + str.tostring(sl, format.mintick), style=label.style_label_left, textcolor=color.red, color=color.new(color.black, 80), size=size.tiny)
    label.new(bar_index + extendBars, t1, "TP1 " + str.tostring(t1, format.mintick), style=label.style_label_left, textcolor=color.aqua, color=color.new(color.black, 80), size=size.tiny)
    label.new(bar_index + extendBars, t2, "TP2 " + str.tostring(t2, format.mintick), style=label.style_label_left, textcolor=color.aqua, color=color.new(color.black, 80), size=size.tiny)
    label.new(bar_index + extendBars, t3, "TP3 " + str.tostring(t3, format.mintick), style=label.style_label_left, textcolor=color.aqua, color=color.new(color.black, 80), size=size.tiny)
// Alert mode: App trades sends ONLY BUY/SELL. Webhook heartbeat sends WAIT on each M5 close.
f_market() =>
    syminfo.type == "futures" ? "futures" : str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "XAG") ? "gold" : "forex"
f_dir(x) => x == 1 ? "buy" : x == -1 ? "sell" : "neutral"
if ready and delivery != "Off"
    active = buy or sell
    d = buy ? 1.0 : -1.0
    e = close
    st = invalidation
    r = math.abs(e - st)
    en = active ? str.tostring(e, format.mintick) : "null"
    sl = active ? str.tostring(st, format.mintick) : "null"
    p1 = active ? str.tostring(e + d * r * rr / 3, format.mintick) : "null"
    p2 = active ? str.tostring(e + d * r * rr * 2 / 3, format.mintick) : "null"
    p3 = active ? str.tostring(e + d * r * rr, format.mintick) : "null"
    if delivery == "App trades" and active
        msg = "Big Ben AI BBB " + (buy ? "BUY" : "SELL") + " | " + syminfo.tickerid + " | M5 | ENTRY " + en + " | SL " + sl + " | TP1 " + p1 + " | TP2 " + p2 + " | TP3 " + p3
        alert(msg, alert.freq_once_per_bar_close)
    if delivery == "Webhook heartbeat" and webhookToken != ""
        payload = '{"secret":"' + webhookToken + '","symbol":"' + syminfo.tickerid + '","type":"' + f_market() + '","signal":"' + (buy ? "buy" : sell ? "sell" : "wait") + '","entry":' + en + ',"stop":' + sl + ',"tp1":' + p1 + ',"tp2":' + p2 + ',"tp3":' + p3 + ',"m15":"neutral","h1":"' + f_dir(h1) + '","h4":"' + f_dir(h4) + '","d1":"neutral","bar_time":"' + str.tostring(time) + '"}'
        alert(payload, alert.freq_once_per_bar_close)
var table panel = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 25))
if barstate.islast and showPanel
    table.cell(panel, 0, 0, "BIG BEN BBB", text_color=color.white)
    table.cell(panel, 1, 0, isM5 ? "M5" : "USE M5", text_color=isM5 ? color.lime : color.orange)
    table.cell(panel, 0, 1, "H1", text_color=color.white)
    table.cell(panel, 1, 1, h1 == 1 ? "UP" : h1 == -1 ? "DOWN" : "FLAT", text_color=color.white)
    table.cell(panel, 0, 2, "H4", text_color=color.white)
    table.cell(panel, 1, 2, h4 == 1 ? "UP" : h4 == -1 ? "DOWN" : "FLAT", text_color=color.white)
    table.cell(panel, 0, 3, "SMT", text_color=color.white)
    table.cell(panel, 1, 3, useSMT ? "REQUIRED" : "OPTIONAL OFF", text_color=color.white)
    table.cell(panel, 0, 4, "Phase", text_color=color.white)
    table.cell(panel, 1, 4, pendingDir != 0 ? "WAIT RETEST" : armedDir != 0 ? "WAIT DISPLACEMENT" : "SCAN", text_color=color.white)
    table.cell(panel, 0, 5, "Signal", text_color=color.white)
    table.cell(panel, 1, 5, buy ? "BUY" : sell ? "SELL" : "WAIT", text_color=buy ? color.lime : sell ? color.red : color.orange)
