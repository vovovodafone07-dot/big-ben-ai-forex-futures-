//@version=6
indicator("Big Ben AI | Clean Signals v6.1", overlay=true, max_lines_count=100, max_labels_count=100)
rr = input.float(2.0, "Risk / Reward", minval=0.5, maxval=10, step=0.5)
direction = input.string("Both", "Direction", options=["Both","Buy","Sell"])
lookback = input.int(15, "Breakout lookback", minval=5, maxval=100)
retestBars = input.int(6, "Maximum bars to retest", minval=1, maxval=30)
atrLen = input.int(14, "ATR period", minval=5)
maxBodyATR = input.float(1.4, "Maximum signal body / ATR", minval=0.2, step=0.1)
maxRiskATR = input.float(2.5, "Maximum stop distance / ATR", minval=0.5, step=0.25)
minRiskATR = input.float(0.3, "Minimum stop distance / ATR", minval=0.1, step=0.1)
cooldown = input.int(3, "Bars after exit", minval=1, maxval=50)
showLevels = input.bool(false, "Draw Entry / SL / TP lines (optional)")
f_trend() =>
    fast = ta.ema(close, 20)
    slow = ta.ema(close, 50)
    close > fast and fast > slow ? 1 : close < fast and fast < slow ? -1 : 0
t15 = request.security(syminfo.tickerid, "15", f_trend()[1], lookahead=barmerge.lookahead_on)
t60 = request.security(syminfo.tickerid, "60", f_trend()[1], lookahead=barmerge.lookahead_on)
t240 = request.security(syminfo.tickerid, "240", f_trend()[1], lookahead=barmerge.lookahead_on)
atr = ta.atr(atrLen)
ema20 = ta.ema(close,20)
ema50 = ta.ema(close,50)
upper = ta.highest(high[1],lookback)
lower = ta.lowest(low[1],lookback)
isM5 = timeframe.isminutes and timeframe.multiplier == 5
bullTrend = ema20 > ema50 and close > ema20 and t15 == 1 and t60 == 1 and t240 != -1
bearTrend = ema20 < ema50 and close < ema20 and t15 == -1 and t60 == -1 and t240 != 1
// Breakout creates a candidate, not an immediate trade.
var int pendingDir = 0
var float pendingLevel = na
var int pendingBar = na
var int tradeDir = 0
var int entryBar = na
var int exitBar = na
var float entry = na
var float stop = na
var float target = na
var string tradeState = "WAIT"
var line entryLine = na
var line stopLine = na
var line tpLine = na
var label entryLabel = na
var label stopLabel = na
var label tpLabel = na
bool buy = false
bool sell = false
if barstate.isconfirmed and isM5
    // Exit checks start on the bar after the signal.
    if tradeDir != 0 and bar_index > entryBar
        slHit = tradeDir == 1 ? low <= stop : high >= stop
        tpHit = tradeDir == 1 ? high >= target : low <= target
        if slHit or tpHit
            tradeState := slHit ? "SL HIT" : "TP HIT"
            tradeDir := 0
            exitBar := bar_index
    if pendingDir != 0 and (bar_index - pendingBar > retestBars or (pendingDir == 1 and not bullTrend) or (pendingDir == -1 and not bearTrend))
        pendingDir := 0
        pendingLevel := na
    canEnter = tradeDir == 0 and (na(exitBar) or bar_index - exitBar > cooldown)
    // Confirm the retest only on a later bar; the signal candle closes beyond the broken level.
    bodyOK = math.abs(close-open) <= atr*maxBodyATR
    if canEnter and pendingDir != 0 and bar_index > pendingBar and bodyOK
        buyStop = ta.lowest(low,5) - atr*0.15
        sellStop = ta.highest(high,5) + atr*0.15
        riskBuy = close-buyStop
        riskSell = sellStop-close
        buy := pendingDir == 1 and bullTrend and direction != "Sell" and low <= pendingLevel + atr*0.15 and close > pendingLevel and close > open and close > ema20 and riskBuy >= atr*minRiskATR and riskBuy <= atr*maxRiskATR
        sell := pendingDir == -1 and bearTrend and direction != "Buy" and high >= pendingLevel - atr*0.15 and close < pendingLevel and close < open and close < ema20 and riskSell >= atr*minRiskATR and riskSell <= atr*maxRiskATR
        if buy or sell
            tradeDir := buy ? 1 : -1
            entryBar := bar_index
            entry := close
            stop := buy ? buyStop : sellStop
            target := entry + tradeDir*math.abs(entry-stop)*rr
            tradeState := buy ? "BUY ACTIVE" : "SELL ACTIVE"
            pendingDir := 0
            pendingLevel := na
            if showLevels
                line.delete(entryLine)
                line.delete(stopLine)
                line.delete(tpLine)
                label.delete(entryLabel)
                label.delete(stopLabel)
                label.delete(tpLabel)
                entryLine := line.new(bar_index,entry,bar_index+20,entry,extend=extend.right,color=color.yellow,width=2)
                stopLine := line.new(bar_index,stop,bar_index+20,stop,extend=extend.right,color=color.red,width=2)
                tpLine := line.new(bar_index,target,bar_index+20,target,extend=extend.right,color=color.aqua,width=2)
                entryLabel := label.new(bar_index,entry,"Entry "+str.tostring(entry,format.mintick),style=label.style_label_left,color=color.new(color.black,70),textcolor=color.yellow)
                stopLabel := label.new(bar_index,stop,"SL "+str.tostring(stop,format.mintick),style=label.style_label_left,color=color.new(color.black,70),textcolor=color.red)
                tpLabel := label.new(bar_index,target,"TP "+str.tostring(target,format.mintick),style=label.style_label_left,color=color.new(color.black,70),textcolor=color.aqua)
    // New breakout candidate only if not already waiting or trading.
    if canEnter and tradeDir == 0 and pendingDir == 0 and not (buy or sell)
        if bullTrend and direction != "Sell" and close > upper and close > open and math.abs(close-open) <= atr*maxBodyATR
            pendingDir := 1
            pendingLevel := upper
            pendingBar := bar_index
        else if bearTrend and direction != "Buy" and close < lower and close < open and math.abs(close-open) <= atr*maxBodyATR
            pendingDir := -1
            pendingLevel := lower
            pendingBar := bar_index
plot(ema20,"EMA 20",color=color.orange,display=display.none)
plot(ema50,"EMA 50",color=color.blue,display=display.none)
plot(pendingDir != 0 ? pendingLevel : na,"Retest level",color=color.new(color.purple,0),style=plot.style_linebr,display=display.none)
plotshape(buy,title="BUY",style=shape.labelup,location=location.belowbar,text="BUY",color=color.green,textcolor=color.white,size=size.small)
plotshape(sell,title="SELL",style=shape.labeldown,location=location.abovebar,text="SELL",color=color.red,textcolor=color.white,size=size.small)
plot(buy or sell ? entry : na,title="Alert Entry",display=display.none)
plot(buy or sell ? stop : na,title="Alert SL",display=display.none)
plot(buy or sell ? target : na,title="Alert TP",display=display.none)
alertcondition(buy,title="Big Ben BUY setup",message='Big Ben BUY {{ticker}} M5 Entry {{plot("Alert Entry")}} SL {{plot("Alert SL")}} TP {{plot("Alert TP")}}')
alertcondition(sell,title="Big Ben SELL setup",message='Big Ben SELL {{ticker}} M5 Entry {{plot("Alert Entry")}} SL {{plot("Alert SL")}} TP {{plot("Alert TP")}}')
