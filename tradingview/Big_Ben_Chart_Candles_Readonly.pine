//@version=6
indicator("Big Ben | ناقل شموع للقراءة فقط", overlay=false)
// Companion transport only. Never modifies the existing strategy or places orders.
enabled = input.bool(false, "تفعيل نقل الشموع")
secret = input.string("", "رمز Webhook من إعدادات الخادم", confirm=true, display=display.none)
plot(close, "سعر الشارت", display=display.none)
if enabled and str.length(secret) >= 32 and timeframe.period == "5" and barstate.isrealtime and barstate.isconfirmed
    stamp = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    opening = str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    body = '{"schema":"bigben.candle.v1","token":"' + secret + '","symbol":"' + syminfo.prefix + ':' + syminfo.ticker + '","timeframe":"5","time":"' + stamp + '","bar_time":"' + opening + '","tick_size":' + str.tostring(syminfo.mintick) + ',"open":' + str.tostring(open, format.mintick) + ',"high":' + str.tostring(high, format.mintick) + ',"low":' + str.tostring(low, format.mintick) + ',"close":' + str.tostring(close, format.mintick) + '}'
    alert(body, alert.freq_once_per_bar_close)
